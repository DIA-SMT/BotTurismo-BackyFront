# Servidor
PORT=3000

# Supabase (misma base que la web)
SUPABASE_URL=tu_url_de_supabase
SUPABASE_SERVICE_KEY=tu_service_role_key

# IA (OpenRouter, misma cuenta que la traduccion de circuitos)
OPENROUTER_API_KEY=tu_sk_de_openrouter
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# WhatsApp Cloud API (Meta) - ver DEPLOY.md para obtener cada valor
WHATSAPP_TOKEN=token_permanente_de_system_user
WHATSAPP_PHONE_NUMBER_ID=id_del_numero_en_meta
WHATSAPP_VERIFY_TOKEN=un_string_secreto_que_elijas_vos
WHATSAPP_APP_SECRET=app_secret_de_la_app_de_meta
# GRAPH_API_VERSION=v21.0

# URL publica del sitio de reservas (para los links que manda el bot)
PUBLIC_SITE_URL=https://tu-dominio-del-sitio
