# ─────────────────────────────────────────────────────────────
# Sitio público Next.js (bus turístico / educativo / admin)
# Copiar a .env.local (ignorado por git) y completar con los valores reales.
# En producción viven en /srv/turismo/compartido/.env de la VPS.
# ─────────────────────────────────────────────────────────────

# ── OBLIGATORIAS ──
# Sin estas, las rutas de servidor tiran "Missing ..." al usarse.

# PostgreSQL. En desarrollo, la base turismo_dev de la VPS por un túnel:
#   ssh -N -L 5433:127.0.0.1:5432 feria-vps
DATABASE_URL=postgresql://USUARIO:CLAVE@127.0.0.1:5433/turismo_dev

# Firma de las sesiones del panel y de los links a archivos. Uno distinto
# por entorno: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
AUTH_SECRET=

# Carpeta de fotos y adjuntos (en la VPS: /srv/turismo/compartido/archivos).
ARCHIVOS_DIR=./archivos

# ── OPCIONALES ──

# Traducción automática de circuitos al inglés (misma cuenta que el bot).
# Sin clave, los circuitos nuevos se muestran en español en la versión EN.
OPENROUTER_API_KEY=
# OPENROUTER_TRANSLATE_MODEL=google/gemini-2.5-flash

# Mail de confirmación de reservas. Si falta, la reserva funciona igual
# y solo se omite el correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM="Bus Turístico SMT <turismo@smt.gob.ar>"
# SMTP_SECURE=false
# SMTP_REPLY_TO=turismo@smt.gob.ar

# URL pública del sitio, usada en los links de los mails (reservas y recuperar clave).
PUBLIC_SITE_URL=http://localhost:3000

# Avisos por WhatsApp: EN PAUSA por decisión de la dirección (2026-09-01),
# pendiente de facturación en Meta. Dejar en false salvo que se reactive.
WHATSAPP_NOTIFICATIONS_ENABLED=false
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Secreto del cron de limpieza de photo books (/api/cron/photo-books-cleanup).
CRON_SECRET=
